# Keeps the Docker build context small and avoids packaging npm workspace symlinks
# (node_modules/@hpl/shared etc.) that break Docker's tar archiver on Windows.
node_modules
**/node_modules
dist
**/dist
.next
**/.next
.git
*.log
npm-debug.log*
.env
.env.local
coverage
.turbo

# Real customer data. Images get pushed to a registry, so these must never be packaged
# (the Sept image shipped apps/backend/prisma/crm-snapshot to a public package).
apps/backend/prisma/crm-snapshot
**/crm-snapshot
apps/backend/uploads
**/uploads
