# --- Postgres (used by docker-compose and by DATABASE_URL below) ---
POSTGRES_USER=hpl_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=hpl_command_center

# --- Backend ---
# NOTE: host ports 5433 (Postgres) / 3005 (frontend) are deliberately non-default to avoid
# colliding with other projects that may already be running on this machine on 5432/3000/3001.
DATABASE_URL=postgresql://hpl_admin:change_me_locally@localhost:5433/hpl_command_center
PORT=4000
JWT_ACCESS_SECRET=change_me_dev_access_secret
JWT_REFRESH_SECRET=change_me_dev_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:3005

# OpenAI — powers the Quotations "Chat AI" / "Voice AI" free-text parsing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# WhatsApp Cloud API (Meta) — sends generated quotation PDFs. See apps/backend/.env for how to
# get a free test number for local development before the client's verified number is ready.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Email (SMTP) — a second quotation-send channel that works today without WhatsApp Business
# verification. See apps/backend/.env for the fastest way to test (Gmail + App Password).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=HPL Maker

# --- Frontend ---
# Browser-facing URL — must be the host-mapped port (browser cannot resolve the "backend" Docker DNS name)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side (Next.js Server Components running inside the frontend container) URL
INTERNAL_API_URL=http://backend:4000
