// HPL Maker — Business Owner Command Center
// Full normalized schema per project-requirements Section 27.
// Only the Phase 1 subset (Auth/RBAC, Dashboard, Sales/Order, Leads, Dealers, Projects, Products)
// is wired to working APIs/UI right now — the rest of this schema exists so later phases
// don't require a reshape. Soft-delete (deletedAt) is on "directory" entities; append-only
// logs (Activity/AuditLog/Notification/OrderItem/AIInsight) are never soft-deleted.
//
// Multi-tenant: every business-data model carries `organizationId`, auto-scoped on every
// query by the org-scope Prisma extension (src/prisma/org-scope.extension.ts) — see that
// file and src/common/context/tenant-context.ts for how the current request's tenant flows
// in. Only Role/Permission/RolePermission (global system RBAC) are exempt — every other
// model, including join tables like LeadSourceOnLead, carries its own organizationId rather
// than relying on scoping transitively through a relation: a direct groupBy/aggregate against
// a join table (e.g. LeadsService.getSourceBreakdown) has no relation filter to inherit from,
// so an unscoped join table is a real cross-tenant leak, not just redundant data. HPL Maker is
// tenant #1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum RoleName {
  OWNER
  SALES_MANAGER
  SALES_EXECUTIVE
  MARKETING_MANAGER
  DEALER_MANAGER
  ADMIN
}

enum PermissionAction {
  READ
  WRITE
  DELETE
  MANAGE
}

enum PermissionModule {
  DASHBOARD
  SALES
  LEADS
  MARKETING
  SALES_TEAM
  DEALERS
  ARCHITECTS
  BUILDERS
  PROJECTS
  CUSTOMERS
  COMPLAINTS
  WARRANTY
  PRODUCTS
  GEOGRAPHY
  AI_INSIGHTS
  NOTIFICATIONS
  REPORTS
  SETTINGS
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  SITE_VISIT
  NOTE
  STATUS_CHANGE
  FOLLOW_UP_SCHEDULED
  SAMPLE_SENT
  QUOTE_SENT
  ORDER_PLACED
}

// LeadStatus/LeadSource/LeadType were fixed enums until the app connected to the real
// HPL CRM, which has a much richer, staff-editable taxonomy (40/17/15 live values) that a
// closed enum can't represent without silently losing data. They're now lookup tables
// (below, near the Lead model) mirroring the CRM's own dynamic status/source/type rows —
// per-tenant, since a different client's CRM taxonomy won't match HPL's.

enum LeadStage {
  OPEN
  WON
  LOST
}

enum DealerStatus {
  ACTIVE
  AT_RISK
  INACTIVE
  NEW
}

enum ProjectStage {
  LEAD
  DISCOVERY
  SAMPLE
  DESIGN_APPROVAL
  QUOTATION
  NEGOTIATION
  ORDER
  COMPLETED
  LOST
}

enum ProjectCategory {
  COMMERCIAL
  RESIDENTIAL
  INDUSTRIAL
  INSTITUTIONAL
  HOSPITALITY
  RETAIL
  DEALER_FACILITY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum CampaignPlatform {
  GOOGLE_ADS
  META_ADS
  WEBSITE
  WHATSAPP
  ORGANIC
  OTHER
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum TouchType {
  FIRST_TOUCH
  LAST_TOUCH
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum WarrantyClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  INSPECTION
  APPROVED
  REJECTED
  RESOLVED
}

enum NotificationType {
  NEW_LEAD
  MISSED_FOLLOW_UP
  HIGH_VALUE_LEAD
  HIGH_VALUE_PROJECT
  INACTIVE_DEALER
  DEALER_RISK
  SALES_TARGET_RISK
  MARKETING_BUDGET_WARNING
  CAMPAIGN_PERFORMANCE_WARNING
  COMPLAINT
  WARRANTY_CLAIM
  PROJECT_INACTIVITY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
}

enum InsightCategory {
  SALES
  MARKETING
  LEADS
  DEALERS
  PROJECTS
  CUSTOMERS
  PRODUCTS
}

enum InsightType {
  RISK
  OPPORTUNITY
}

enum InsightStatus {
  NEW
  REVIEWED
  DISMISSED
  ACTIONED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
  DEALER_SELF
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum SalesTargetScope {
  COMPANY
  SALES_EXECUTIVE
  DEALER
  PRODUCT_CATEGORY
}

enum TargetPeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum QuotationStatus {
  DRAFT
  SENT
  SEND_FAILED
}

enum QuotationInputMode {
  MANUAL
  CHAT_AI
  VOICE_AI
}

enum QuotationEmailStatus {
  SENT
  FAILED
}

enum IntegrationProvider {
  META_ADS
  GOOGLE_ADS
  GOOGLE_ANALYTICS
  SEARCH_CONSOLE
  WOOCOMMERCE
  WHATSAPP
  EMAIL_SMTP
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────

// The tenant root. HPL Maker is the first row (slug "hpl-maker"); every business-data
// model below points back here via organizationId. No plan/billing fields yet — add
// when the product actually has paying tenants beyond HPL Maker.
model Organization {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  users                      User[]
  salesExecutives            SalesExecutive[]
  customers                  Customer[]
  leads                      Lead[]
  leadStatuses               LeadStatus[]
  leadSources                LeadSource[]
  leadTypes                  LeadType[]
  leadActivities             LeadActivity[]
  dealers                    Dealer[]
  dealerActivities           DealerActivity[]
  architects                 Architect[]
  builders                   Builder[]
  projects                   Project[]
  projectActivities          ProjectActivity[]
  productCategories          ProductCategory[]
  productShades              ProductShade[]
  products                   Product[]
  orders                     Order[]
  orderItems                 OrderItem[]
  salesTargets               SalesTarget[]
  marketingCampaigns         MarketingCampaign[]
  websiteAnalyticsDaily      WebsiteAnalyticsDaily[]
  searchConsoleDaily         SearchConsoleDaily[]
  searchConsoleTopQueries    SearchConsoleTopQuery[]
  marketingLeadAttributions  MarketingLeadAttribution[]
  complaints                 Complaint[]
  warrantyClaims             WarrantyClaim[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  aiInsights                 AIInsight[]
  companyProfiles            CompanyProfile[]
  quotationCounter           QuotationCounter?
  leadCounter                LeadCounter?
  quotations                 Quotation[]
  quotationItems             QuotationItem[]
  leadSourceOnLeads          LeadSourceOnLead[]
  integrationConnections     IntegrationConnection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Auth / RBAC  (Phase 1)
// ─────────────────────────────────────────────────────────────────────────

model User {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  email            String
  passwordHash     String
  name             String
  phone            String?
  roleId           String
  role             Role            @relation(fields: [roleId], references: [id])
  isActive         Boolean         @default(true)
  isPlatformAdmin  Boolean         @default(false) // grants cross-tenant /platform-admin access — see PlatformAdminGuard. Set only via prisma/set-platform-admin.ts, never self-serve.
  lastLoginAt      DateTime?
  refreshTokenHash String?
  salesExecutive   SalesExecutive?
  auditLogs        AuditLog[]
  notifications    Notification[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  @@unique([organizationId, email])
  @@index([roleId])
  @@index([organizationId])
}

// Roles/Permissions stay global system RBAC shared across all tenants — not org-scoped.
// Revisit if tenants ever need custom roles.
model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String?
  isSystem    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // e.g. "sales:read", "leads:write"
  module      PermissionModule
  action      PermissionAction
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// ─────────────────────────────────────────────────────────────────────────
// Sales org + Customers  (Phase 1)
// ─────────────────────────────────────────────────────────────────────────

model SalesExecutive {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  employeeCode   String
  userId         String?          @unique
  user           User?            @relation(fields: [userId], references: [id])
  name           String
  email          String?
  phone          String?
  designation    String
  state          String?
  managerId      String?
  manager        SalesExecutive?  @relation("ExecManager", fields: [managerId], references: [id])
  reports        SalesExecutive[] @relation("ExecManager")
  hireDate       DateTime?
  status         EmployeeStatus   @default(ACTIVE)

  leads             Lead[]
  leadActivities    LeadActivity[]
  dealerActivities  DealerActivity[]
  projects          Project[]
  projectActivities ProjectActivity[]
  orders            Order[]
  targets           SalesTarget[]
  managedDealers    Dealer[]          @relation("DealerManager")
  complaints        Complaint[]
  warrantyClaims    WarrantyClaim[]
  quotations        Quotation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
}

model Customer {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  customerCode      String
  name              String
  companyName       String?
  phone             String
  email             String?
  type              CustomerType
  city              String
  state             String
  address           String?
  firstPurchaseAt   DateTime?
  lastPurchaseAt    DateTime?
  lifetimeValue     Decimal      @default(0) @db.Decimal(14, 2) // cached; recomputed from Order sums
  satisfactionScore Float?
  notes             String?

  orders         Order[]
  projects       Project[]
  complaints     Complaint[]
  warrantyClaims WarrantyClaim[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, customerCode])
  @@index([organizationId, state, city])
}

// ─────────────────────────────────────────────────────────────────────────
// Leads  (Phase 1)
// ─────────────────────────────────────────────────────────────────────────

model Lead {
  id                    String             @id @default(cuid())
  organizationId        String
  organization          Organization       @relation(fields: [organizationId], references: [id])
  crmId                 Int? // external HPL CRM lead id, for sync upserts — unique per tenant
  leadCode              String
  name                  String
  company               String?
  phone                 String
  email                 String?
  sources               LeadSourceOnLead[]
  campaignId            String?
  campaign              MarketingCampaign? @relation(fields: [campaignId], references: [id])
  referredByArchitectId String?
  referredByArchitect   Architect?         @relation(fields: [referredByArchitectId], references: [id])
  referredByBuilderId   String?
  referredByBuilder     Builder?           @relation(fields: [referredByBuilderId], references: [id])
  state                 String
  city                  String
  leadTypeId            String?
  leadType              LeadType?          @relation(fields: [leadTypeId], references: [id])
  assignedExecId        String?
  assignedExec          SalesExecutive?    @relation(fields: [assignedExecId], references: [id])
  statusId              String?
  status                LeadStatus?        @relation(fields: [statusId], references: [id])
  score                 Int                @default(0)
  estimatedValue        Decimal?           @db.Decimal(14, 2)
  nextFollowUpAt        DateTime?
  lastActivityAt        DateTime?
  wonAt                 DateTime?
  lostAt                DateTime?
  lostReason            String?
  convertedProjectId    String?
  convertedCustomerId   String?
  notes                 String?
  address               String? // free-form; business-card scans are the first source that reliably has this
  website               String?
  businessCardImagePath String? // set only when the scanning user opted to save the source card image

  activities   LeadActivity[]
  attributions MarketingLeadAttribution[]
  quotations   Quotation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, leadCode])
  @@unique([organizationId, crmId])
  @@index([organizationId, statusId])
  @@index([organizationId, leadTypeId])
  @@index([organizationId, assignedExecId])
  @@index([organizationId, state, city])
}

// Mirrors the CRM's own per-status row (name, stage, ordering) instead of a closed enum —
// see the note near LeadStage above. `stage` classifies each real CRM status as an editable
// OPEN/WON/LOST bucket (used by KPIs/funnel/scoring) without baking status names into code.
model LeadStatus {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  crmId          Int?
  name           String
  stage          LeadStage    @default(OPEN)
  score          Int          @default(5)
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  leads          Lead[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, crmId])
}

model LeadSource {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  crmId          Int?
  name           String
  score          Int                @default(10)
  isActive       Boolean            @default(true)
  leads          LeadSourceOnLead[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, crmId])
}

// A Lead can carry multiple sources at once (e.g. both "Facebook" and "Google Ads"),
// same as the CRM — this join table replaces what used to be a single scalar column.
// Carries its own organizationId (denormalized from Lead) rather than relying on relation
// scoping — LeadsService.getSourceBreakdown groupBy()s this table directly, and a groupBy
// has no relation filter to inherit from.
model LeadSourceOnLead {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  leadSourceId   String
  leadSource     LeadSource   @relation(fields: [leadSourceId], references: [id])

  @@id([leadId, leadSourceId])
  @@index([organizationId])
}

model LeadType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  crmId          Int?
  name           String
  isActive       Boolean      @default(true)
  leads          Lead[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@unique([organizationId, crmId])
}

model LeadActivity {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead            @relation(fields: [leadId], references: [id])
  type           ActivityType
  note           String?
  performedById  String?
  performedBy    SalesExecutive? @relation(fields: [performedById], references: [id])
  occurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([organizationId, leadId, occurredAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Dealers  (Phase 1)
// ─────────────────────────────────────────────────────────────────────────

model Dealer {
  id                   String          @id @default(cuid())
  organizationId       String
  organization         Organization    @relation(fields: [organizationId], references: [id])
  dealerCode           String
  name                 String
  contactName          String?
  phone                String
  email                String?
  city                 String
  state                String
  address              String?
  status               DealerStatus    @default(NEW)
  assignedManagerId    String?
  assignedManager      SalesExecutive? @relation("DealerManager", fields: [assignedManagerId], references: [id])
  joinedAt             DateTime
  healthScore          Int? // 0-100, computed by DealerScoringService, cached
  healthScoreBreakdown Json? // { orderFrequency, revenue, recentActivity, growth, recency } labels+values
  healthScoreUpdatedAt DateTime?

  orders         Order[]
  activities     DealerActivity[]
  projects       Project[]
  targets        SalesTarget[]
  complaints     Complaint[]
  warrantyClaims WarrantyClaim[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, dealerCode])
  @@index([organizationId, status])
  @@index([organizationId, state, city])
}

// NOTE: totalOrders / revenue / growth / lastOrder are NEVER stored columns —
// always derived via Order aggregation in DealersService.

model DealerActivity {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  dealerId       String
  dealer         Dealer          @relation(fields: [dealerId], references: [id])
  type           ActivityType
  note           String?
  performedById  String?
  performedBy    SalesExecutive? @relation(fields: [performedById], references: [id])
  occurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([organizationId, dealerId, occurredAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Architects / Builders  (schema now — /architects /builders UI is Phase 2)
// ─────────────────────────────────────────────────────────────────────────

model Architect {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  company        String?
  city           String
  state          String
  phone          String?
  email          String?
  joinedAt       DateTime?
  lastActivityAt DateTime?

  projects Project[]
  leads    Lead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
}

model Builder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  company        String?
  city           String
  state          String
  phone          String?
  email          String?
  joinedAt       DateTime?
  lastActivityAt DateTime?

  projects Project[]
  leads    Lead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Projects  (Phase 1)
// ─────────────────────────────────────────────────────────────────────────

model Project {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  projectCode     String
  name            String
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  architectId     String?
  architect       Architect?      @relation(fields: [architectId], references: [id])
  builderId       String?
  builder         Builder?        @relation(fields: [builderId], references: [id])
  dealerId        String?
  dealer          Dealer?         @relation(fields: [dealerId], references: [id])
  salesExecId     String?
  salesExec       SalesExecutive? @relation(fields: [salesExecId], references: [id])
  city            String
  state           String
  category        ProjectCategory
  typeLabel       String // e.g. "Office Park", "Villas"
  estimatedValue  Decimal         @db.Decimal(14, 2)
  expectedHplQty  Int?
  stage           ProjectStage    @default(LEAD)
  probability     Int             @default(10)
  stageSince      DateTime        @default(now())
  expectedCloseAt DateTime?
  nextFollowUpAt  DateTime?
  lastActivityAt  DateTime?
  notes           String?

  orders     Order[]
  activities ProjectActivity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, projectCode])
  @@index([organizationId, stage])
  @@index([organizationId, state, city])
  @@index([organizationId, salesExecId])
}

// weighted pipeline value = estimatedValue * probability/100 — computed, not stored.
// "Quotation" is the QUOTATION stage value, not a separate table; Order.projectId
// links an order back to the project it converted from.

model ProjectActivity {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id])
  type           ActivityType
  fromStage      ProjectStage?
  toStage        ProjectStage?
  note           String?
  performedById  String?
  performedBy    SalesExecutive? @relation(fields: [performedById], references: [id])
  occurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())

  @@index([organizationId, projectId, occurredAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Products  (Phase 1)
// ─────────────────────────────────────────────────────────────────────────

model ProductCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // Interior HPL / Exterior Cladding / Compact Laminate / Bathroom Cubicle — doubles as "HPL type"
  products       Product[]
  targets        SalesTarget[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, name])
}

model ProductShade {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // Walnut Brown, Ivory Matte, Onyx Black Marble...
  hexPreview     String?
  products       Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, name])
}

model Product {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  sku            String
  name           String
  wcId           Int? // WooCommerce product id (hplmaker.com) — set only for products.wc-sync-synced rows
  categoryId     String
  category       ProductCategory @relation(fields: [categoryId], references: [id])
  shadeId        String?
  shade          ProductShade?   @relation(fields: [shadeId], references: [id])
  design         String? // "Woodgrain", "Marble", "Solid", "Stone"
  unitPrice      Decimal         @db.Decimal(10, 2)
  isActive       Boolean         @default(true)

  orderItems     OrderItem[]
  complaints     Complaint[]
  warrantyClaims WarrantyClaim[]
  quotationItems QuotationItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, sku])
  @@unique([organizationId, wcId])
  @@index([organizationId, categoryId])
  @@index([organizationId, shadeId])
}

// ─────────────────────────────────────────────────────────────────────────
// Orders — the real transactional ledger Sales/Dealers/Products/Command Center
// all read from  (Phase 1)
// ─────────────────────────────────────────────────────────────────────────

model Order {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  orderCode      String
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id])
  dealerId       String?
  dealer         Dealer?         @relation(fields: [dealerId], references: [id])
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id])
  salesExecId    String?
  salesExec      SalesExecutive? @relation(fields: [salesExecId], references: [id])
  status         OrderStatus     @default(CONFIRMED)
  orderDate      DateTime        @default(now())
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  subtotal       Decimal         @db.Decimal(14, 2)
  discountAmount Decimal         @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal         @db.Decimal(14, 2)
  state          String // denormalized copy for fast geo aggregation
  city           String

  items          OrderItem[]
  warrantyClaims WarrantyClaim[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, orderCode])
  @@index([organizationId, orderDate])
  @@index([organizationId, dealerId])
  @@index([organizationId, customerId])
  @@index([organizationId, salesExecId])
  @@index([organizationId, state])
}

model OrderItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int
  unitPrice      Decimal      @db.Decimal(10, 2)
  lineTotal      Decimal      @db.Decimal(14, 2)
  createdAt      DateTime     @default(now())

  @@index([organizationId, orderId])
  @@index([organizationId, productId])
}

// ─────────────────────────────────────────────────────────────────────────
// Sales Targets  (Phase 1 — backs Command Center / Sales "Target Achievement")
// ─────────────────────────────────────────────────────────────────────────

model SalesTarget {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  scope             SalesTargetScope
  salesExecutiveId  String?
  salesExecutive    SalesExecutive?  @relation(fields: [salesExecutiveId], references: [id])
  dealerId          String?
  dealer            Dealer?          @relation(fields: [dealerId], references: [id])
  productCategoryId String?
  productCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id])
  periodType        TargetPeriodType
  periodStart       DateTime
  periodEnd         DateTime
  targetRevenue     Decimal          @db.Decimal(14, 2)
  targetOrders      Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId, scope, periodStart, periodEnd])
}

// achievedRevenue is NEVER stored — always computed live from Order for the same period+scope.
// Service-layer validation: exactly one of salesExecutiveId/dealerId/productCategoryId is set
// when scope != COMPANY; all null when scope == COMPANY.

// ─────────────────────────────────────────────────────────────────────────
// Marketing  (schema now — /marketing UI is Phase 2)
// ─────────────────────────────────────────────────────────────────────────

model MarketingCampaign {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  name             String
  platform         CampaignPlatform
  status           CampaignStatus   @default(ACTIVE)
  spend            Decimal          @db.Decimal(12, 2)
  metaCampaignId   String? // Meta Graph API campaign id — set only for real META_ADS-synced rows
  googleCampaignId String? // Google Ads campaign id — set only for real GOOGLE_ADS-synced rows, see google-ads-sync.service.ts
  leadsCount       Int              @default(0) // real (Meta "lead" action / Google Ads conversions) for synced rows, fabricated for seeded ones
  revenue          Decimal          @default(0) @db.Decimal(12, 2) // fabricated-only — never set against real ad spend, see meta-ads-sync.service.ts
  impressions      Int              @default(0) // real for synced rows, 0 for seeded ones
  clicks           Int              @default(0) // real for synced rows, 0 for seeded ones
  ctr              Decimal          @default(0) @db.Decimal(7, 4) // percentage (e.g. 4.3333 = 4.3333%), not a fraction
  avgCpc           Decimal          @default(0) @db.Decimal(10, 2) // average cost per click, same currency unit as spend
  dailyBudget      Decimal?         @db.Decimal(12, 2) // Google Ads only for now — Meta's daily_budget is returned in the account's minor currency unit and needs the account currency to convert correctly, see meta-ads-sync.service.ts
  bidStrategy      String?
  startDate        DateTime
  endDate          DateTime?
  notes            String?

  leads        Lead[]
  attributions MarketingLeadAttribution[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, metaCampaignId])
  @@unique([organizationId, googleCampaignId])
}

model WebsiteAnalyticsDaily {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  date              DateTime     @db.Date
  sessions          Int
  activeUsers       Int
  newUsers          Int
  pageViews         Int
  conversions       Int
  engagementRate    Decimal      @db.Decimal(5, 4)
  avgSessionSeconds Decimal      @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, date])
}

model SearchConsoleDaily {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  date           DateTime     @db.Date
  clicks         Int
  impressions    Int
  ctr            Decimal      @db.Decimal(6, 5)
  position       Decimal      @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, date])
}

model SearchConsoleTopQuery {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  date           DateTime     @db.Date
  query          String
  clicks         Int
  impressions    Int
  ctr            Decimal      @db.Decimal(6, 5)
  position       Decimal      @db.Decimal(6, 2)

  createdAt DateTime @default(now())

  @@unique([organizationId, date, query])
}

model MarketingLeadAttribution {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead              @relation(fields: [leadId], references: [id])
  campaignId     String
  campaign       MarketingCampaign @relation(fields: [campaignId], references: [id])
  touchType      TouchType
  occurredAt     DateTime          @default(now())

  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Complaints / Warranty  (schema now — UI is Phase 3)
// ─────────────────────────────────────────────────────────────────────────

model Complaint {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  complaintCode  String
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  productId      String?
  product        Product?        @relation(fields: [productId], references: [id])
  dealerId       String?
  dealer         Dealer?         @relation(fields: [dealerId], references: [id])
  issue          String
  priority       Priority
  status         ComplaintStatus @default(OPEN)
  assignedToId   String?
  assignedTo     SalesExecutive? @relation(fields: [assignedToId], references: [id])
  dueAt          DateTime?
  resolvedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, complaintCode])
}

model WarrantyClaim {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id])
  claimCode       String
  customerId      String
  customer        Customer            @relation(fields: [customerId], references: [id])
  productId       String
  product         Product             @relation(fields: [productId], references: [id])
  orderId         String?
  order           Order?              @relation(fields: [orderId], references: [id])
  dealerId        String?
  dealer          Dealer?             @relation(fields: [dealerId], references: [id])
  purchaseDate    DateTime
  warrantyMonths  Int
  claimDate       DateTime
  status          WarrantyClaimStatus @default(SUBMITTED)
  inspectionNotes String?
  resolution      String?
  assignedToId    String?
  assignedTo      SalesExecutive?     @relation(fields: [assignedToId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, claimCode])
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications / Audit / AI  (Notification + AuditLog wired in Phase 1;
// AI Insights UI is Phase 4)
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?             @relation(fields: [userId], references: [id])
  targetRole     RoleName? // broadcast to a role when userId is null
  type           NotificationType
  priority       Priority
  title          String
  message        String
  linkModule     PermissionModule?
  linkRecordId   String?
  isRead         Boolean           @default(false)
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  @@index([organizationId, userId, isRead])
}

model AuditLog {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  action         AuditAction
  module         PermissionModule
  recordId       String?
  beforeValue    Json?
  afterValue     Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime         @default(now())

  @@index([organizationId, module, recordId])
  @@index([organizationId, userId, createdAt])
}

model AIInsight {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id])
  category          InsightCategory
  type              InsightType
  priority          Priority
  headline          String
  whatHappened      String
  whyItHappened     String
  businessImpact    String
  recommendedAction String
  confidence        Int
  sourceRefModule   PermissionModule?
  sourceRefId       String?
  status            InsightStatus     @default(NEW)
  generatedAt       DateTime          @default(now())
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())

  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Quotations — proforma-invoice generation + WhatsApp send from a Lead
// ─────────────────────────────────────────────────────────────────────────

// A reusable letterhead/bank-details preset ("Company Detail Template"), NOT a singleton —
// the operator picks one per quotation (e.g. different branches/entities). The PDF's visual
// layout is always the same fixed template (quotation.hbs); only this data block varies.
model CompanyProfile {
  id                           String       @id @default(cuid())
  organizationId               String
  organization                 Organization @relation(fields: [organizationId], references: [id])
  label                        String // e.g. "Default", "Shreenath Global - Mumbai Branch"
  isDefault                    Boolean      @default(false)
  isActive                     Boolean      @default(true)
  name                         String
  addressLine1                 String
  addressLine2                 String?
  city                         String
  state                        String
  phone                        String
  email                        String?
  gstin                        String
  logoDataUrl                  String? // data: URI, small enough to inline into the PDF template directly
  bankName                     String
  bankAccountNumber            String
  bankIfsc                     String
  bankSwift                    String?
  defaultTermsAndConditions    String // newline-separated, editable per-quotation after prefill
  defaultAdvancePercent        Int          @default(50)
  defaultBeforeDispatchPercent Int          @default(50)
  validityDays                 Int          @default(30)

  quotations Quotation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
}

// One counter row per tenant (organizationId IS the primary key), incremented
// transactionally by QuotationNumberingService to generate race-free sequential
// reference numbers (PI-2026-0001, ...) scoped to that tenant.
model QuotationCounter {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id])
  seq            Int          @default(0)
}

// Race-free per-tenant sequence for CARD-<year>-<seq> codes issued to leads created via
// business-card scanning — the first manual (non-CRM-sync) lead-creation path. Mirrors
// QuotationCounter.
model LeadCounter {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id])
  seq            Int          @default(0)
}

model Quotation {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  quotationCode    String
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id])
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id])

  // Customer details are snapshotted at generation time (not just a Lead FK lookup) so a
  // quotation's printed content never drifts if the Lead record changes afterward.
  customerName    String
  customerCompany String?
  customerAddress String
  customerCity    String
  customerState   String
  customerGstin   String?
  customerContact String

  quotationDate DateTime @default(now())
  validUntil    DateTime

  subtotal    Decimal @db.Decimal(14, 2)
  gstAmount   Decimal @db.Decimal(14, 2)
  roundoff    Decimal @db.Decimal(14, 2)
  totalAmount Decimal @db.Decimal(14, 2)

  advancePercent        Int
  beforeDispatchPercent Int
  advanceAmount         Decimal @db.Decimal(14, 2)
  beforeDispatchAmount  Decimal @db.Decimal(14, 2)

  termsAndConditions String

  status       QuotationStatus    @default(DRAFT)
  inputMode    QuotationInputMode
  rawInputText String? // the original chat/voice free text, for audit — null for MANUAL

  pdfPath           String?
  sentToPhone       String?
  whatsappMessageId String?
  sentAt            DateTime?

  emailSentTo String?
  emailSentAt DateTime?
  emailStatus QuotationEmailStatus?

  createdById String?
  createdBy   SalesExecutive? @relation(fields: [createdById], references: [id])

  items QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, quotationCode])
  @@index([organizationId, leadId])
}

model QuotationItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  quotationId    String
  quotation      Quotation    @relation(fields: [quotationId], references: [id])
  srNo           Int
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  itemName       String
  hsnCode        String?
  quantity       Int
  unitRate       Decimal      @db.Decimal(10, 2)
  taxPercent     Decimal      @default(18) @db.Decimal(5, 2)
  lineAmount     Decimal      @db.Decimal(14, 2)
  lineTax        Decimal      @db.Decimal(14, 2)
  lineTotal      Decimal      @db.Decimal(14, 2)

  @@index([organizationId, quotationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Integration connections — per-tenant third-party credentials (Meta/Google Ads/GA4/Search
// Console/WooCommerce/WhatsApp/Email). Replaces the old single global .env credential set now
// that a second tenant needs its own. `credentials` is an encrypted JSON blob (see
// src/common/crypto/integration-credentials.ts) whose shape depends on `provider` — never
// decrypted or returned by the API, only used server-side by the sync services.
// ─────────────────────────────────────────────────────────────────────────

model IntegrationConnection {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  provider       IntegrationProvider
  credentials    String // encrypted JSON blob
  isActive       Boolean             @default(true)
  lastSyncedAt   DateTime?
  lastSyncError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider])
  @@index([provider, isActive])
}
